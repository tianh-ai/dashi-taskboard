  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/tianmac/Library/Logs/dashi-taskboard/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tianmac/Library/Logs/dashi-taskboard/backup-error.log</string>
</dict>
</plist>
